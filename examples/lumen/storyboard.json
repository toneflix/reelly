{
  "name": "lumen",
  "url": "../demo",
  "product": { "name": "Lumen", "tagline": "Notes that think with you.", "url": "lumen.app" },
  "fps": 30,
  "bpm": 120,
  "beatsPerBar": 4,
  "viewport": { "width": 1920, "height": 1080, "deviceScaleFactor": 1.5 },
  "hide": ["#cookie-banner"],
  "font": { "family": "Inter Tight", "weights": [300, 600, 800] },
  "theme": { "background": "#07080d", "text": "#f4f4ff", "accent": "#8f82ff" },
  "music": { "mode": "synth", "key": "D", "seed": 7 },
  "poster": { "item": "endcard", "at": 10 },

  "sections": [
    { "id": "open",  "bars": 4, "energy": 0.15, "cut": "dissolve" },
    { "id": "write", "bars": 6, "energy": 0.4,  "cut": "dissolve" },
    { "id": "plan",  "bars": 6, "energy": 0.65, "cut": "hard" },
    { "id": "share", "bars": 4, "energy": 0.8,  "cut": "hard" },
    { "id": "rush",  "bars": 4, "energy": 1.0,  "cut": "hard" },
    { "id": "lift",  "bars": 2, "energy": 0.5,  "cut": "flash" },
    { "id": "end",   "bars": 4, "energy": 0.3,  "cut": "flash" }
  ],

  "timeline": [
    { "type": "title", "id": "opener", "section": "open", "bars": 2, "style": "opener", "reveal": "words",
      "text": "Every idea needs a *home.*" },

    { "type": "shot", "id": "home", "section": "open", "bars": 2, "path": "/",
      "camera": [ { "at": 0, "zoom": 1.25, "center": "h1" }, { "at": 8, "zoom": 1.0 } ] },

    { "type": "shot", "id": "editor", "section": "write", "bars": 4, "path": "/#/editor", "cursor": [1500, 860],
      "actions": [
        { "at": 2, "do": "click", "target": "#typing-line", "beats": 1.5 },
        { "at": 2.5, "do": "type", "text": "Ship it with the whole team.", "beats": 5 },
        { "at": 11, "do": "hover", "target": ".s-item", "beats": 2 },
        { "at": 13, "do": "click", "target": ".s-item", "beats": 1 }
      ],
      "camera": [
        { "at": 0, "zoom": 1.0 },
        { "at": 2.5, "zoom": 1.3, "center": [1160, 330] },
        { "at": 8, "zoom": 1.3, "center": [1160, 330] },
        { "at": 11, "zoom": 1.15, "center": "#suggest", "offset": [-300, 0] },
        { "at": 16, "zoom": 1.1, "center": "#suggest", "offset": [-300, 0] }
      ],
      "titles": [ { "at": 1, "beats": 6, "style": "lower", "text": "Write it down." } ] },

    { "type": "shot", "id": "pages", "section": "write", "bars": 2, "path": "/#/editor", "cursor": [900, 700],
      "actions": [
        { "at": 1.5, "do": "click", "target": "#new-page", "beats": 1.5 },
        { "at": 5, "do": "click", "target": ".page:nth-of-type(3)", "beats": 1.5 }
      ],
      "camera": [ { "at": 0, "zoom": 1.45, "center": [600, 440] }, { "at": 8, "zoom": 1.4, "center": [640, 450] } ] },

    { "type": "shot", "id": "board", "section": "plan", "bars": 4, "path": "/#/board", "cursor": [1200, 900],
      "actions": [
        { "at": 2, "do": "drag", "from": "#card-2", "to": "#col-doing", "toOffset": [0, 120], "beats": 3.5 },
        { "at": 9, "do": "drag", "from": "#card-4", "to": "#col-done", "toOffset": [0, 160], "beats": 3.5 }
      ],
      "camera": [
        { "at": 0, "zoom": 1.0 },
        { "at": 2, "zoom": 1.2, "center": "cursor" },
        { "at": 12.5, "zoom": 1.2, "center": "cursor" },
        { "at": 16, "zoom": 1.0 }
      ],
      "titles": [ { "at": 0.5, "beats": 5, "style": "lower", "text": "Plan it out." } ] },

    { "type": "shot", "id": "insights", "section": "plan", "bars": 2, "path": "/#/board", "cursor": [1400, 500],
      "actions": [ { "at": 1, "do": "click", "target": "nav a[data-route=insights]", "beats": 1 } ],
      "camera": [ { "at": 0, "zoom": 1.0 }, { "at": 8, "zoom": 1.06, "center": [960, 560] } ] },

    { "type": "shot", "id": "share", "section": "share", "bars": 4, "path": "/#/editor", "cursor": [1300, 500],
      "actions": [
        { "at": 1, "do": "click", "target": "#share-btn", "beats": 1 },
        { "at": 3, "do": "click", "target": "#invite", "beats": 1 },
        { "at": 3.5, "do": "type", "text": "maya@studio.co", "beats": 3 },
        { "at": 8, "do": "click", "target": "#invite-send", "beats": 1.5 },
        { "at": 12, "do": "click", "target": ".sw", "beats": 2 }
      ],
      "camera": [
        { "at": 0, "zoom": 1.0 },
        { "at": 2, "zoom": 1.35, "center": ".modal" },
        { "at": 13, "zoom": 1.5, "center": ".modal", "offset": [0, 140] },
        { "at": 16, "zoom": 1.5, "center": ".modal", "offset": [0, 140] }
      ],
      "titles": [ { "at": 0.5, "beats": 5, "style": "lower", "text": "Bring everyone in." } ] },

    { "type": "montage", "id": "rush", "section": "rush", "pattern": [[4, 2], [4, 1], [8, 0.5]],
      "slides": [
        { "path": "/", "zoom": 1.3, "center": "h1" },
        { "path": "/#/editor", "zoom": 1.5, "center": [700, 330] },
        { "path": "/#/board", "zoom": 1.25, "center": "#col-doing" },
        { "path": "/#/insights", "settle": 2.5, "zoom": 1.5, "center": [560, 300] },
        { "from": "share", "at": 15, "zoom": 1.3, "center": [960, 640] },
        { "from": "editor", "at": 10, "zoom": 1.4, "center": [900, 500] },
        { "from": "board", "at": 7, "zoom": 1.3, "center": [960, 540] },
        { "path": "/#/board", "zoom": 1.4, "center": "#col-done" },
        { "path": "/#/insights", "settle": 2.5, "zoom": 1.5, "center": "#chart" },
        { "path": "/#/board", "zoom": 1.5, "center": "#card-6" },
        { "path": "/#/editor", "zoom": 1.5, "center": ".checks" },
        { "path": "/#/editor", "prepare": [ { "do": "click", "target": "#share-btn" } ], "zoom": 1.4, "center": ".modal" },
        { "from": "share", "at": 9, "zoom": 1.55, "center": [960, 600] },
        { "from": "pages", "at": 7, "zoom": 1.5, "center": [420, 400] },
        { "path": "/#/board", "zoom": 1.35, "center": "#col-todo" },
        { "path": "/", "zoom": 1.2, "center": ".cta" }
      ] },

    { "type": "title", "id": "line", "section": "lift", "bars": 2, "style": "word", "text": "One calm page." },

    { "type": "title", "id": "endcard", "section": "end", "bars": 4, "style": "endcard" }
  ],

  "cues": [
    { "bar": 4, "type": "hit" },
    { "bar": 8, "type": "riser", "bars": 2 },
    { "bar": 10, "type": "impact" },
    { "bar": 16, "type": "braam" },
    { "bar": 18, "type": "riser", "bars": 2 },
    { "bar": 20, "type": "impact", "flash": true },
    { "bar": 24, "type": "impact" },
    { "bar": 24, "type": "roll", "bars": 1.5 },
    { "bar": 25, "beat": 2, "type": "silence", "beats": 2 },
    { "bar": 26, "type": "impact", "flash": true },
    { "bar": 26, "type": "braam" }
  ]
}
